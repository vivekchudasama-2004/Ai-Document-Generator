# DocuForge root env — copy to .env for local dev. Mirror in Vercel Dashboard for prod.
# Local: web http://localhost:3000  |  api http://localhost:8000

# --- Database (TiDB Cloud, MySQL protocol, REQUIRED for data endpoints) ---
TIDB_URL=mysql+pymysql://user:pass@gateway01.tidbcloud.com:4000/docuforge?ssl_ca=/etc/ssl/certs/ca-certificates.crt

# --- NVIDIA NIM (REQUIRED for generation; NIM_MOCK=true runs offline demo) ---
NVIDIA_NIM_API_KEY=nvapi-xxx
NIM_MOCK=false
DEFAULT_GENERATION_MODEL=auto
DEFAULT_HUMANIZE_MODEL=auto
# "auto" picks the cheapest capable model from prompt complexity (recommended).
ALLOWED_MODELS=mistralai/mistral-large-2-instruct,nvidia/llama-3.1-nemotron-70b-instruct,mistralai/mistral-7b-instruct-v0.3

# --- Auth ---
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRE_MIN=60
COOKIE_SECURE=false
# ^ set COOKIE_SECURE=true in Vercel/prod (https only)
REFRESH_EXPIRE_DAYS=7

# --- BYOK: encrypts users' saved provider keys (OpenRouter/Groq/custom) ---
# Set a long random value in prod. Rotating JWT_SECRET instead orphans saved keys.
LLM_KEYS_SECRET=

# --- Email (forgot password, Resend free 100/day) ---
RESEND_API_KEY=re_xxx
RESEND_FROM=DocuForge <noreply@yourdomain.com>
PUBLIC_APP_URL=http://localhost:3000

# --- Object storage (exports; missing = local fallback served via download endpoint) ---
CLOUDINARY_URL=

# --- Analyzer ---
DETECTOR_MODE=spacy+api
DEMO_MODE=false
SAPLING_API_KEY=

# --- Retrieval: similar-section search (embeddings API + stored vectors, no local ML) ---
# Any OpenAI-compatible /v1/embeddings endpoint (Voyage, Cohere, …). Empty = /api/rag/* answers 503.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
